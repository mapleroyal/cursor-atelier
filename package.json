{
  "name": "cursor-atelier",
  "productName": "Cursor Atelier",
  "version": "0.1.0",
  "description": "A quiet cursor pack manager for macOS and Linux built with Electron.",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:clean": "node scripts/clean-package-output.mjs",
    "make": "electron-forge make",
    "native:packs": "python3 native/cursor-packs/build_all.py",
    "native:build": "node scripts/native-build.mjs",
    "native:preflight": "node scripts/native-preflight.mjs",
    "curated:build": "scripts/build-curated-converter.sh",
    "curated:verify": "native/cursor-packs/build/curated-converter/curated-cursor-converter/curated-cursor-converter self-test",
    "icon:build": "scripts/build-icon.sh",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run package && playwright test",
    "shadcn:list": "node -e 'const { execFileSync } = require(\"node:child_process\"); const get = (o, l) => JSON.parse(execFileSync(\"npx\", [\"shadcn@latest\", \"list\", \"@shadcn\", \"-l\", String(l), \"-o\", String(o)], { encoding: \"utf8\" })); const total = get(0, 1).pagination?.total ?? 0; const seen = new Set(); for (let o = 0; o < total; o += 100) for (const item of get(o, 100).items ?? []) if (item.type === \"registry:ui\" && !seen.has(item.name)) { seen.add(item.name); console.log(item.name); }'",
    "app:install": "node scripts/install-linux.mjs"
  },
  "keywords": [],
  "author": "Cursor Atelier contributors",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@napi-rs/lzma": "1.5.1",
    "@tanstack/react-query": "^5.101.4",
    "@upng/upng-js": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "extract-zip": "^2.0.1",
    "plist": "^5.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tar": "7.5.22",
    "undici": "^7.29.0",
    "yauzl": "^3.4.0",
    "zustand": "^5.0.14"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
