{
  "name": "electron-template",
  "version": "1.0.0",
  "description": "",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "shadcn:list": "node -e 'const { execFileSync } = require(\"node:child_process\"); const get = (o, l) => JSON.parse(execFileSync(\"npx\", [\"shadcn@latest\", \"list\", \"@shadcn\", \"-l\", String(l), \"-o\", String(o)], { encoding: \"utf8\" })); const total = get(0, 1).pagination?.total ?? 0; const seen = new Set(); for (let o = 0; o < total; o += 100) for (const item of get(o, 100).items ?? []) if (item.type === \"registry:ui\" && !seen.has(item.name)) { seen.add(item.name); console.log(item.name); }'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
